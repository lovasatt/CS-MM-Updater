#!/bin/bash
# @Author: Kenny Lindelof <contact@kennyl.tv>
# @Date:   2017-04-29 17:09:32
# @Last Modified by:   lovasatt
# @Last Modified time: 2026-10-11 12:00:00
# @Repo: https://github.com/lovasatt/CS-MM-Updater
#
####################################################################################################
# Set Folders
WORKING="/home/hlstatsx/plugins"  # This is the directory of the install or update files
CS2_WORKING_DIR="/usr/local/steam/csgo/game/csgo"  # This is the directory path of "gameinfo.gi" file
####################################################################################################

# Set Colors
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

# Metamod installation check
GI_FILE="${CS2_WORKING_DIR}/gameinfo.gi"

if [ ! -f "${GI_FILE}" ]; then
    echo "Error: ${GI_FILE} does not exist in the specified directory."
    exit 1
fi

if grep -Eq '^[[:space:]]*Game[[:space:]]+csgo/addons/metamod' "$GI_FILE"; then
    echo -e "${GREEN}'Game    csgo/addons/metamod'${NC} already exists in a gameinfo.gi"
else
    sed -i -e '/Game_LowViolence/a\\t\t\tGame    csgo/addons/metamod' "$GI_FILE"
    echo -e "${YELLOW}gameinfo.gi has been modified successfully.${NC}"
fi

# Please be sure to have the folling installed.
# CuRL wget unzip
# Check and install packages if missing.
pkgs='curl wget unzip patchelf'
install=false
for pkg in $pkgs; do
  status="$(dpkg-query -W --showformat='${db:Status-Status}' "$pkg" 2>&1)"
  if [ ! $? = 0 ] || [ ! "$status" = installed ]; then
    install=true
    break
  fi
done
if "$install"; then
  sudo apt install -y $pkgs
fi

# Working Directory For The Script
mkdir -p $WORKING
cd $WORKING

# Getting the latest MetaMod
MM_URL=$(curl -s https://api.github.com/repos/alliedmodders/metamod-source/releases |
    grep browser_download_url |
    grep 'mmsource-2.0' |
    grep -oP 'https://[^"]*mmsource-.*-linux\.tar\.gz' |
    head -n 1)

if [ -z "$MM_URL" ]; then
    echo -e "${YELLOW}Warning: Could not fetch MetaMod URL from GitHub. Skipping.${NC}"
else
    MM_CURRENT=$(basename "$MM_URL")
    MM_LOCAL=$(ls mmsource-*-linux.tar.gz 2>/dev/null | head -n 1)

# Downloads the Current MM Version
if [[ -n "$MM_CURRENT" && "$MM_CURRENT" = "$MM_LOCAL" ]]
    then
        echo -e "The latest metamod is already installed."
    else
        echo -e "${YELLOW}Downloading the new version of metamod...${NC}"
        rm -fr mmsource-*-linux.tar.gz
        wget -q "$MM_URL"
        tar -xf "$MM_CURRENT"
        cp addons/ $CS2_WORKING_DIR/ -R
        patchelf --clear-execstack "$CS2_WORKING_DIR/addons/counterstrikesharp/bin/linuxsteamrt64/counterstrikesharp.so"
        patchelf --clear-execstack "$CS2_WORKING_DIR/addons/multiaddonmanager/bin/multiaddonmanager.so"
        echo "Done."
    fi
fi

# Determining the current CounterStrikeSharp Version
latestURL=$(curl -s https://api.github.com/repos/roflmuffin/CounterStrikeSharp/releases/latest |
    grep browser_download_url |
    grep -oP 'https://[^"]*counterstrikesharp-with-runtime-linux-[^"]*\.zip' |
    head -n 1)

if [ -z "$latestURL" ]; then
    echo -e "${YELLOW}Warning: Could not fetch CounterStrikeSharp URL from GitHub. Skipping.${NC}"
else
    latestFile=$(basename "$latestURL")
    latestVer=$(echo "$latestFile" | sed -r 's/counterstrikesharp-with-runtime-linux-//; s/\.zip//')
    CS_LOCAL=$(ls counterstrikesharp-with-runtime-linux-*.zip 2>/dev/null | head -n 1)

# Getting the latest CounterStrikeSharp
if [[ -n "$latestFile" && "$latestFile" = "$CS_LOCAL" ]]
    then
        echo -e "The latest CounterStrikeSharp is already installed."
    else
        echo -e "${YELLOW}Downloading the new version of CounterStrikeSharp...${NC}"
        rm -fr counterstrikesharp-with-runtime-linux-*.zip
        wget -q "$latestURL"
        unzip -qo "$latestFile"
        cp addons/ $CS2_WORKING_DIR/ -R
        patchelf --clear-execstack "$CS2_WORKING_DIR/addons/counterstrikesharp/bin/linuxsteamrt64/counterstrikesharp.so"
        patchelf --clear-execstack "$CS2_WORKING_DIR/addons/multiaddonmanager/bin/multiaddonmanager.so"
        echo "Done."
    fi
fi

# Determining the current MultiAddonManager Version (Fixed to steamrt4 for Debian 13)
MAM_URL=$(curl -s https://api.github.com/repos/Source2ZE/MultiAddonManager/releases/latest |
    grep browser_download_url |
    grep -i 'tar.gz' |
    grep -iv 'windows' |
    grep -i 'steamrt4' |
    grep -oP 'https://[^"]*MultiAddonManager-[^"]*steamrt4[^"]*\.tar\.gz' |
    head -n 1)

if [ -z "$MAM_URL" ]; then
    echo -e "${YELLOW}Warning: Could not fetch MultiAddonManager URL from GitHub. Skipping.${NC}"
else
    MA_latestFile=$(basename "$MAM_URL")
    MA_latestVer=$(echo "$MA_latestFile" | sed -r 's/MultiAddonManager-v//; s/-[^\.]+\.tar\.gz//')
    MA_LOCAL=$(ls MultiAddonManager-*-steamrt4.tar.gz 2>/dev/null | head -n 1)

# Getting the latest MultiAddonManager
if [[ -n "$MA_latestFile" && "$MA_latestFile" = "$MA_LOCAL" ]]
    then
        echo -e "The latest MultiAddonManager is already installed."
    else
        echo -e "${YELLOW}Downloading the new version of MultiAddonManager (SteamRT4)...${NC}"
        rm -fr MultiAddonManager-*-steamrt4.tar.gz
        wget -q "$MAM_URL"
        tar -xf "$MA_latestFile"
        rm cfg/ -fR
        cp addons/ $CS2_WORKING_DIR/ -R
        patchelf --clear-execstack "$CS2_WORKING_DIR/addons/counterstrikesharp/bin/linuxsteamrt64/counterstrikesharp.so"
        patchelf --clear-execstack "$CS2_WORKING_DIR/addons/multiaddonmanager/bin/multiaddonmanager.so"
        echo "Done."
    fi
fi

# Copy files to gaming directory
#cp addons/ $CS2_WORKING_DIR/ -R

echo
echo -e "MetaMod Version: ${GREEN}$MM_CURRENT${NC}"
echo -e "CounterStrikeSharp Version: ${GREEN}$latestVer${NC}"
echo -e "MultiAddonManager Version: ${GREEN}$MA_latestVer${NC}"
echo

# =========================
# WRITE JSON FOR CS PLUGIN
# =========================
[ -z "$MM_CURRENT" ] && MM_CURRENT=$(ls mmsource-*-linux.tar.gz 2>/dev/null | head -n 1)
[ -z "$latestVer" ]  && latestVer=$(ls counterstrikesharp-with-runtime-linux-*.zip 2>/dev/null | head -n 1 | sed -r 's/counterstrikesharp-with-runtime-linux-//; s/\.zip//')
[ -z "$MA_latestVer" ] && MA_latestVer=$(ls MultiAddonManager-*-steamrt4.tar.gz 2>/dev/null | head -n 1 | sed -r 's/MultiAddonManager-v//; s/-[^\.]+\.tar\.gz//')

JSON_FILE="$(dirname "$(dirname "$(dirname "$CS2_WORKING_DIR")")")/versions.json"

cat > "$JSON_FILE" <<EOF
{
  "metamod": "$(echo "$MM_CURRENT" | sed -E 's/mmsource-//; s/-linux.tar.gz//')",
  "counterstrikesharp": "$(echo "$latestVer" | sed -E 's/^v//')",
  "multiaddonmanager": "$(echo "$MA_latestVer" | sed -E 's/^v//')"
}
EOF

echo -e "${GREEN}versions.json successfully updated: $JSON_FILE${NC}"

cd ../
